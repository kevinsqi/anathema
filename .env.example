# Copy to .env and fill in. Everything is optional: without keys the game
# runs with the built-in word list and manual scoring only.

# Word list generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Speech-to-text auto-detection
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Minimum per-word confidence for a transcript match to count (0-1)
STT_MIN_CONFIDENCE=0.5

# Server
PORT=3000
DB_PATH=data/anathema.db
